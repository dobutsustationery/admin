rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{name=**}/requests/{action} {
      // Read all collections named 'requests' in entire db where the target is the current user.
      allow read: if request.auth.uid == resource.data.target;
    }
    match /from/{uid}/to/{uid2}/requests/{action} {
      // Force data's creator to be uid, and data's target to be uid2.
      allow write: if uid == request.auth.uid && request.resource.data.creator == request.auth.uid && request.resource.data.target == uid2;
    }
    match /broadcast/{action} {
      // Immutable event log: create-only, and creator must match authed user
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid
        && (!request.resource.data.keys().hasAny(["type"])
          || !(request.resource.data.type in ["amazonPrepare/draftDecisionChanged", "amazonPrepare/draftPricingChanged", "amazonPrepare/draftViewChanged", "amazonPrepare/draftApplied", "amazonPrepare/draftDiscarded"])
          || request.resource.data.payload.owner == request.auth.uid);
      allow read: if request.auth != null;
    }
    match /sync/{action} {
      // Sync event log: client may only create whitelisted response events.
      allow create: if request.auth != null
        && request.resource.data.creator == request.auth.uid
        && (request.resource.data.eventType in [
          "photos/image_transfer_secret_provided"
        ] || (request.resource.data.eventType == "etsy/sync_requested"
          && action == "etsy-listings-" + request.resource.data.requestId + "-requested"
          && getAfter(/databases/$(database)/documents/request_etsy_listings/$(request.resource.data.requestId)).data.creator == request.auth.uid));
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    match /request_shopify_sync/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_etsy_listings/{id} {
      allow create: if request.auth != null
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.keys().hasOnly(["creator", "mode", "field", "entries", "createdAt"])
        && (request.resource.data.mode == "refresh"
          || (request.resource.data.mode == "sync"
            && request.resource.data.field in ["quantity", "price", "title", "description"]
            && request.resource.data.entries is list
            && request.resource.data.entries.size() > 0
            && request.resource.data.entries.size() <= 100));
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    match /etsy_listing_catalog/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /etsy_listing_sync/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /etsy_listing_results/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /etsy_listing_mappings/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(["itemKey", "creator", "updatedAtMs"])
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.itemKey is string
        && request.resource.data.itemKey.size() > 0
        && request.resource.data.itemKey.size() <= 200;
      allow delete: if false;
    }
    match /request_shopify_listing_audit/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_shopify_catalog_sync/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_amazon_prepare/{action} {
      allow create: if request.auth != null
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.keys().hasOnly(["creator", "sellerId", "marketplaceId", "mode", "entries", "jobIds", "stockConfirmed", "createdAt"])
        && request.resource.data.sellerId is string
        && request.resource.data.marketplaceId == "A1F83G8C2ARO7P"
        && ((request.resource.data.mode == "preview" && request.resource.data.entries is list && request.resource.data.entries.size() > 0 && request.resource.data.entries.size() <= 100)
          || (request.resource.data.mode == "publish" && request.resource.data.stockConfirmed == true && request.resource.data.jobIds is list && request.resource.data.jobIds.size() > 0 && request.resource.data.jobIds.size() <= 100));
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_amazon_audit/{action} {
      allow create: if request.auth != null
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.keys().hasOnly(["creator", "marketplaceId", "mode", "skus", "createdAt"])
        && request.resource.data.marketplaceId == "A1F83G8C2ARO7P"
        && request.resource.data.mode in ["catalogue", "selected"]
        && request.resource.data.skus is list
        && request.resource.data.skus.size() <= 100;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_amazon_catalog_scan/{id} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid
        && request.resource.data.keys().hasOnly(["creator", "marketplaceId", "jans", "limit", "negativeBefore", "createdAt"])
        && request.resource.data.marketplaceId == "A1F83G8C2ARO7P"
        && request.resource.data.jans is list && request.resource.data.jans.size() <= 20000;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    match /amazon_catalog_scans/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /request_amazon_catalog_probe/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_amazon_listing_create/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_amazon_product_type_discovery/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_amazon_listing_restrictions/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_photos_transfer/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_photos_transform/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /request_google_auth/{action} {
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow update, delete: if false;
    }
    match /google_auth_results/{uid}/requests/{requestId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }
    match /sync_secrets/{docId} {
      // Private short-lived secret handoff docs for sync workers.
      // Clients may create/update/delete only their own docs. Backend admin bypasses rules.
      allow create: if request.auth != null && request.resource.data.creator == request.auth.uid;
      allow update: if request.auth != null && resource.data.creator == request.auth.uid && request.resource.data.creator == request.auth.uid;
      allow read: if request.auth != null && resource.data.creator == request.auth.uid;
      allow delete: if request.auth != null && resource.data.creator == request.auth.uid;
    }
    match /jailed/{action} {
      // Force data's creator to be uid
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    match /dobutsu/{document=**} {
      allow read: if request.auth != null;
    }
  }
}
