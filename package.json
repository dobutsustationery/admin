{
  "name": "dobutsu-admin",
  "version": "0.0.1",
  "description": "A basic order and inventory management system.",
  "author": "Alex Nicolaou",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node scripts/patch-playwright.cjs",
    "dev": "vite dev",
    "dev:local": "vite dev --mode emulator",
    "dev:staging": "vite dev --mode staging",
    "dev:production": "vite dev --mode production",
    "env:local": "node scripts/switch-env.js local",
    "env:staging": "node scripts/switch-env.js staging",
    "env:production": "node scripts/switch-env.js production",
    "env:functions:local": "node scripts/prepare-functions-env.js local",
    "env:functions:staging": "node scripts/prepare-functions-env.js staging",
    "env:functions:production": "node scripts/prepare-functions-env.js production",
    "firebase:convert": "node scripts/firebase-config-to-env.js",
    "firebase:convert:staging": "node scripts/firebase-config-to-env.js --env staging --output .env.staging",
    "firebase:convert:production": "node scripts/firebase-config-to-env.js --env production --output .env.production",
    "auth": "firebase login",
    "emulators": "npm run functions:install && npm run env:functions:local && firebase emulators:start",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --import=./emulator-data",
    "build": "vite build",
    "build:local": "vite build --mode emulator",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "CI=1 vitest run --coverage",
    "test:bun": "bun test tests/",
    "test:watch": "vitest watch --coverage",
    "test:unit": "CI=1 vitest run --coverage",
    "test:e2e": "CI=1 bash e2e/run-tests.sh",
    "test:e2e:local-images": "CI=1 bash e2e/run-tests-local-images.sh",
    "test:download-images": "node e2e/helpers/download-test-images.js",
    "test:e2e:simple": "CI=1 bash e2e/run-tests-simple.sh",
    "test:e2e:interactive": "CI=0 bash e2e/run-tests.sh",
    "test:e2e:screenshots": "CI=1 bash e2e/run-tests.sh --update-snapshots",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report e2e/reports/html",
    "precommit": "node scripts/check-e2e-standards.js",
    "format": "prettier --write \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js}\"",
    "lint": "prettier --check \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js}\" && node scripts/check-no-date-now-in-reducers.mjs",
    "lint:fix": "prettier --write \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js}\"",
    "ci": "prettier --check \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js}\" && node scripts/check-no-date-now-in-reducers.mjs",
    "data:export": "node scripts/transfer-data.js",
    "data:import": "node scripts/transfer-data.js",
    "data:transfer": "node scripts/transfer-data.js",
    "broadcast:jail": "node scripts/jail-broadcast-since.mjs",
    "shopify:sync": "bun scripts/shopify-sync.ts",
    "shopify:sync:request": "bun scripts/shopify-sync-request.ts",
    "shopify:sync:worker": "bun scripts/shopify-sync-worker.ts",
    "deploy": "npm run deploy:production",
    "functions:install": "npm --prefix functions install",
    "deploy:functions": "npm run deploy:functions:production",
    "deploy:functions:staging": "npm run env:functions:staging && firebase deploy --only functions --project staging",
    "deploy:functions:production": "npm run env:functions:production && firebase deploy --only functions --project production",
    "deploy:production": "npm run env:functions:production && vite build --mode production && firebase deploy --only firestore,hosting,functions --project production",
    "deploy:staging": "npm run env:functions:staging && vite build --mode staging && firebase deploy --only firestore,hosting,functions --project staging",
    "fixtures:google:sync": "bun scripts/google-fixtures/sync-seed.ts",
    "fixtures:google:sync:quick": "bun scripts/google-fixtures/sync-seed.ts --limit=1",
    "fixtures:google:cleanup": "bun scripts/google-fixtures/cleanup-run-sandbox.ts",
    "setup:live:e2e": "bun scripts/google-fixtures/bootstrap-live-e2e.ts",
    "setup:live:tokens": "bun scripts/google-fixtures/refresh-live-tokens.ts",
    "test:live:doctor": "bun scripts/google-fixtures/healthcheck.ts",
    "test:live:vitest": "CI=1 VITEST_INCLUDE_LIVE=1 vitest run --testNamePattern @live",
    "test:live:contracts": "npm run test:live:vitest",
    "test:live:workflows": "npm run test:live:vitest",
    "test:live:e2e": "CI=1 bash e2e/run-live-tests.sh",
    "test:live:e2e:screenshots": "CI=1 bash e2e/run-live-tests.sh --update-snapshots",
    "prepare": "husky"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-auto": "^2.0.0",
    "@sveltejs/kit": "^1.20.4",
    "@sveltejs/package": "^2.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/papaparse": "^5.5.1",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^0.34.6",
    "firebase-tools": "^14.26.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.1.9",
    "svelte": "^4.0.5",
    "svelte-check": "^3.4.3",
    "tslib": "^2.8.1",
    "typescript": "5.4",
    "vite": "^4.4.2",
    "vitest": "^0.34.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "@google/genai": "^1.33.0",
    "@json2csv/plainjs": "^7.0.3",
    "@ourway/patch": "^0.1.2",
    "@reduxjs/toolkit": "^1.9.7",
    "@sveltejs/adapter-static": "^2.0.3",
    "@xenova/transformers": "^2.17.2",
    "@zxing/library": "^0.20.0",
    "canvas-confetti": "^1.9.4",
    "common-substrings": "^3.0.1",
    "cropperjs": "^1.5.13",
    "date-fns": "^4.1.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^12.0.0",
    "googleapis": "^128.0.0",
    "lucide-svelte": "^0.556.0",
    "papaparse": "^5.5.3",
    "sharp": "^0.33.5",
    "three": "^0.180.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ],
  "main": "svelte.config.js",
  "directories": {
    "test": "tests"
  },
  "keywords": []
}
