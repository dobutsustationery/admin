.DS_Store
.direnv
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
/coverage
emulator-data
emulator-restores

# Service account keys (security sensitive)
service-account-*.json
!service-account-example.json

# Data transfer temporary files
.data-transfer-tmp
data-export

# Playwright E2E test artifacts
/e2e/reports
/playwright-report
/test-results
# Exclude actual screenshots but keep baselines
# Baselines are in e2e/###-testname/screenshots/ and MUST be committed
/e2e/*-actual.png
/e2e/*-diff.png


# Shopify CLI temporary files
shopify.app.toml

# Firebase cache
.firebase/

# Firebase debug logs
*.log
firestore-debug.log
ui-debug.log
# Keep static/test-images symlink out of git (it's created at test time)
static/test-images

# Reproducible replay/blast-radius worktrees and artifacts
.blastradius/

# output file from running svelte check
check_output.txt
check_errors.txt
test_output.txt

# Playwright auth state (contains OAuth access tokens)
e2e/live/.auth/
