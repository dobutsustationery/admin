#!/bin/bash

# e2e-deflake: Run an E2E test multiple times to check for flakiness and performance.
# Usage: ./e2e-deflake <test-path> [runs]

TEST_PATH=$1
RUNS=${2:-10}

if [ -z "$TEST_PATH" ]; then
  echo "Usage: $0 <test-path> [runs]"
  exit 1
fi

echo "🧪 Deflaking test: $TEST_PATH"
echo "🔄 Target runs: $RUNS"
echo "-----------------------------------"

PASS_COUNT=0
FAIL_COUNT=0
TOTAL_DURATION=0

for ((i=1; i<=RUNS; i++)); do
  echo -n "Run #$i: "
  START_TIME=$(date +%s)
  
  # On first run, we optionally update snapshots if requested or if it's the pattern
  # The user says test:e2e:screenshots passes, so let's use that for Run #1
  COMMAND="test:e2e"
  if [ $i -eq 1 ]; then
    COMMAND="test:e2e:screenshots -- --update-snapshots all"
    echo -n "(Updating Snapshots) "
  fi

  if CI=1 npm run $COMMAND -- "$TEST_PATH" > /dev/null 2>&1; then
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))
    echo "✅ PASS (${DURATION}s)"
    PASS_COUNT=$((PASS_COUNT + 1))
    TOTAL_DURATION=$((TOTAL_DURATION + DURATION))
  else
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))
    echo "❌ FAIL (${DURATION}s)"
    FAIL_COUNT=$((FAIL_COUNT + 1))
    TOTAL_DURATION=$((TOTAL_DURATION + DURATION))
  fi
done

AVG_DURATION=$(echo "scale=2; $TOTAL_DURATION / $RUNS" | bc)
PASS_RATE=$(echo "scale=2; ($PASS_COUNT / $RUNS) * 100" | bc)

echo "-----------------------------------"
echo "📊 Results for $TEST_PATH"
echo "Total Runs:   $RUNS"
echo "Passes:       $PASS_COUNT"
echo "Failures:     $FAIL_COUNT"
echo "Pass Rate:    $PASS_RATE%"
echo "Avg Duration: ${AVG_DURATION}s"
