#!/usr/bin/env sh

set -e

# Isolate push-time test infrastructure from a developer's local environment.
# +10000 offset from common local defaults (4173/8080/9099/5001/4000).
export E2E_PREVIEW_PORT=14173
export E2E_PREVIEW_BASE_URL="http://localhost:${E2E_PREVIEW_PORT}"
export E2E_FIRESTORE_EMULATOR_HOST=localhost
export E2E_FIRESTORE_EMULATOR_PORT=18080
export FIRESTORE_EMULATOR_HOST="${E2E_FIRESTORE_EMULATOR_HOST}:${E2E_FIRESTORE_EMULATOR_PORT}"
export E2E_AUTH_EMULATOR_PORT=19099
export E2E_AUTH_EMULATOR_URL="http://localhost:${E2E_AUTH_EMULATOR_PORT}"
export E2E_FUNCTIONS_EMULATOR_PORT=15001
export E2E_EMULATOR_UI_PORT=14000
export E2E_FIREBASE_CONFIG_PATH="firebase.prepush.json"
export E2E_EMULATOR_LOG_PATH="/tmp/dobutsu-prepush-emulators.log"

PREPUSH_EMULATOR_PID=""

check_prepush_emulators() {
  curl -s "http://${E2E_FIRESTORE_EMULATOR_HOST}:${E2E_FIRESTORE_EMULATOR_PORT}" >/dev/null 2>&1 \
    && curl -s "http://localhost:${E2E_AUTH_EMULATOR_PORT}" >/dev/null 2>&1
}

cleanup_prepush_emulators() {
  if [ -n "${PREPUSH_EMULATOR_PID}" ]; then
    echo "Stopping pre-push emulator stack (PID: ${PREPUSH_EMULATOR_PID})..."
    kill "${PREPUSH_EMULATOR_PID}" 2>/dev/null || true
  fi
}

trap cleanup_prepush_emulators EXIT INT TERM

if check_prepush_emulators; then
  echo "Pre-push emulators already running on isolated ports."
else
  echo "Starting pre-push emulator stack..."
  (npm run env:functions:local && firebase emulators:start --config "${E2E_FIREBASE_CONFIG_PATH}") > "${E2E_EMULATOR_LOG_PATH}" 2>&1 &
  PREPUSH_EMULATOR_PID=$!
  echo "Pre-push emulators started (PID: ${PREPUSH_EMULATOR_PID})"
  echo "Waiting for Firestore/Auth emulators..."
  i=1
  while [ $i -le 60 ]; do
    if check_prepush_emulators; then
      echo "Pre-push emulators are ready."
      break
    fi
    if [ $i -eq 60 ]; then
      echo "Pre-push emulators failed to become ready in time."
      tail -120 "${E2E_EMULATOR_LOG_PATH}" || true
      exit 1
    fi
    i=$((i + 1))
    sleep 1
  done
fi

echo "Running pre-push non-live E2E suite..."
npm run test:e2e

echo "Running pre-push live fixture health check..."
npm run test:live:doctor

echo "Running pre-push live contract tests..."
npm run test:live:contracts

echo "Running pre-push live workflow tests..."
npm run test:live:workflows

echo "Running pre-push live E2E suite..."
npm run test:live:e2e
