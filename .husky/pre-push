#!/usr/bin/env sh

set -e

# Isolate push-time test infrastructure from a developer's local environment.
# +10000 offset from common local defaults (4173/8080/9099/5001/4000).
export E2E_PREVIEW_PORT=14173
export E2E_PREVIEW_BASE_URL="http://localhost:${E2E_PREVIEW_PORT}"
export E2E_FIRESTORE_EMULATOR_HOST=localhost
export E2E_FIRESTORE_EMULATOR_PORT=18080
export FIRESTORE_EMULATOR_HOST="${E2E_FIRESTORE_EMULATOR_HOST}:${E2E_FIRESTORE_EMULATOR_PORT}"
export E2E_AUTH_EMULATOR_PORT=19099
export E2E_AUTH_EMULATOR_URL="http://localhost:${E2E_AUTH_EMULATOR_PORT}"
export E2E_FUNCTIONS_EMULATOR_PORT=15001
export E2E_EMULATOR_UI_PORT=14000
export E2E_FIREBASE_CONFIG_PATH="firebase.prepush.json"
export E2E_FIREBASE_PROJECT_ID="demo-test-project"
export E2E_EMULATOR_LOG_PATH="/tmp/dobutsu-prepush-emulators.log"
export E2E_LIVE_IMPORT_TIMEOUT_MS="${E2E_LIVE_IMPORT_TIMEOUT_MS:-30000}"
export E2E_LIVE_IMPORT_RETRIES="${E2E_LIVE_IMPORT_RETRIES:-1}"
export E2E_LIVE_001_TEST_TIMEOUT_MS="${E2E_LIVE_001_TEST_TIMEOUT_MS:-180000}"
export E2E_LIVE_002_TEST_TIMEOUT_MS="${E2E_LIVE_002_TEST_TIMEOUT_MS:-150000}"
export E2E_FIXED_CREATED_TIME="${E2E_FIXED_CREATED_TIME:-2025-01-15T10:00:00.000Z}"

PREPUSH_EMULATOR_PID=""
PREPUSH_EMULATOR_TIMEOUT_SECONDS="${PREPUSH_EMULATOR_TIMEOUT_SECONDS:-20}"

check_prepush_emulators() {
  curl -s "http://${E2E_FIRESTORE_EMULATOR_HOST}:${E2E_FIRESTORE_EMULATOR_PORT}" >/dev/null 2>&1 \
    && curl -s "http://localhost:${E2E_AUTH_EMULATOR_PORT}" >/dev/null 2>&1
}

print_prepush_port_diagnostics() {
  if command -v lsof >/dev/null 2>&1; then
    echo "Port diagnostics:"
    lsof -nP -iTCP:"${E2E_PREVIEW_PORT}" -sTCP:LISTEN || true
    lsof -nP -iTCP:"${E2E_FIRESTORE_EMULATOR_PORT}" -sTCP:LISTEN || true
    lsof -nP -iTCP:"${E2E_AUTH_EMULATOR_PORT}" -sTCP:LISTEN || true
  fi
}

kill_stale_prepush_port_processes() {
  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  for port in "${E2E_FIRESTORE_EMULATOR_PORT}" "${E2E_AUTH_EMULATOR_PORT}"; do
    pids="$(lsof -t -nP -iTCP:"${port}" -sTCP:LISTEN 2>/dev/null | tr '\n' ' ')"
    [ -z "${pids}" ] && continue

    echo "Found listener(s) on pre-push port ${port}: ${pids}"
    for pid in ${pids}; do
      comm="$(ps -p "${pid}" -o comm= 2>/dev/null | tr -d ' ')"
      comm_base="$(basename "${comm}" 2>/dev/null || echo "${comm}")"
      # Kill java (Firestore/emulator hub) and node (Auth emulator) processes on
      # isolated pre-push ports. These ports are exclusively reserved for pre-push
      # emulators so it is safe to kill any emulator-runtime process found there.
      if [ "${comm_base}" = "java" ] || [ "${comm_base}" = "node" ]; then
        echo "Killing stray ${comm_base} process ${pid} on port ${port}..."
        kill "${pid}" 2>/dev/null || true
      else
        echo "Leaving non-emulator process ${pid} (${comm:-unknown}) on port ${port}."
      fi
    done
  done

  # Give killed processes a moment to release sockets.
  sleep 1
}

kill_stale_preview_server() {
  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  pids="$(lsof -t -nP -iTCP:"${E2E_PREVIEW_PORT}" -sTCP:LISTEN 2>/dev/null | tr '\n' ' ')"
  [ -z "${pids}" ] && return 0

  echo "Killing stale preview listener(s) on port ${E2E_PREVIEW_PORT}: ${pids}"
  for pid in ${pids}; do
    kill "${pid}" 2>/dev/null || true
  done
  sleep 1
}

cleanup_prepush_emulators() {
  if [ -n "${PREPUSH_EMULATOR_PID}" ]; then
    echo "Stopping pre-push emulator stack (PID: ${PREPUSH_EMULATOR_PID})..."
    kill "${PREPUSH_EMULATOR_PID}" 2>/dev/null || true
  fi
}

trap cleanup_prepush_emulators EXIT INT TERM

if check_prepush_emulators; then
  echo "Pre-push emulators already running on isolated ports. Killing and restarting for a clean, owned run..."
  kill_stale_prepush_port_processes
fi

echo "Starting pre-push emulator stack..."
print_prepush_port_diagnostics
(npm run env:functions:local && firebase emulators:start --project "${E2E_FIREBASE_PROJECT_ID}" --config "${E2E_FIREBASE_CONFIG_PATH}") > "${E2E_EMULATOR_LOG_PATH}" 2>&1 &
PREPUSH_EMULATOR_PID=$!
echo "Pre-push emulators started (PID: ${PREPUSH_EMULATOR_PID})"
echo "Waiting for Firestore/Auth emulators..."
i=1
while [ $i -le "${PREPUSH_EMULATOR_TIMEOUT_SECONDS}" ]; do
  if check_prepush_emulators; then
    echo "Pre-push emulators are ready."
    break
  fi
  if ! kill -0 "${PREPUSH_EMULATOR_PID}" 2>/dev/null; then
    echo "Pre-push emulator process exited before becoming ready."
    tail -120 "${E2E_EMULATOR_LOG_PATH}" || true
    print_prepush_port_diagnostics
    exit 1
  fi
  if [ $i -eq "${PREPUSH_EMULATOR_TIMEOUT_SECONDS}" ]; then
    echo "Pre-push emulators failed to become ready in time."
    tail -120 "${E2E_EMULATOR_LOG_PATH}" || true
    print_prepush_port_diagnostics
    exit 1
  fi
  i=$((i + 1))
  sleep 1
done

echo "Running pre-push live fixture health check..."
npm run test:live:doctor

echo "Running pre-push live Vitest suite..."
npm run test:live:vitest

echo "Running pre-push live E2E suite..."
kill_stale_preview_server
env CI=1 npm run test:live:e2e

echo "Running pre-push non-live E2E suite..."
kill_stale_preview_server
env CI=1 npm run test:e2e
